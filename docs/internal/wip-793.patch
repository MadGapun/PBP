+++ b/src/bewerbungs_assistent/services/erkenntnis_status.py
@@ -0,0 +1,179 @@
+"""Gelerntes verwalten: bestaetigen, widersprechen, vergessen, loeschen (#793).
+
+Bis hierher kannte eine Erkenntnis drei Zustaende: offen (0), bestaetigt
+(1) und widersprochen (-1, wird nie wieder vorgeschlagen). Es fehlte der
+Fall "war richtig, gilt nicht mehr" — etwa nach einer geaenderten Haltung
+zu einer Vertragsform. Widersprechen haette das Thema fuer immer
+verbrannt, Bestaetigen liesse mit einer falschen Praemisse weiterarbeiten.
+
+Deshalb der vierte Zustand **vergessen** (-2): die Aussage verschwindet aus
+dem aktiven Kontext (`is_active=0`, kein Ollama-Kontext), bleibt aber als
+Geschichte erhalten und blockiert die Neu-Ableitung NICHT — beim naechsten
+Lauf darf dieselbe Aussage aus den aktuellen Daten wieder entstehen.
+
+Jede Aenderung steht in `learning_insight_events` (von, nach, wann, wodurch).
+Ohne das liesse sich spaeter nicht rekonstruieren, warum PBP an einem Tag
+anders entschieden hat.
+
+Rohdaten bleiben unangetastet: hier werden nur Erkenntnisse geaendert,
+nie Bewerbungen, Stellen oder Aussortier-Gruende.
+"""
+from __future__ import annotations
+
+from datetime import date, datetime
+from typing import Any
+
+STATUS = {"offen": 0, "bestaetigt": 1, "widersprochen": -1, "vergessen": -2}
+_NAME = {v: k for k, v in STATUS.items()}
+
+#: Ein Satz je Zustand — derselbe in Werkzeug und Oberflaeche.
+ERKLAERUNG = {
+    "bestaetigt": "Stimmt — darf der lokalen KI als Hintergrund dienen.",
+    "widersprochen": "War falsch — PBP schlägt diese Aussage nie wieder vor.",
+    "vergessen": ("War einmal richtig, gilt aber nicht mehr — PBP darf sie "
+                  "aus den heutigen Daten neu ableiten."),
+    "geloescht": "Zeile weg, ohne Merker — etwa für Reste aus Testläufen.",
+}
+
+
+def status_name(wert) -> str:
+    return _NAME.get(int(wert or 0), "offen")
+
+
+def tabelle_anlegen(conn) -> None:
+    """Safety-Net statt Schema-Bump."""
+    conn.execute("""
+        CREATE TABLE IF NOT EXISTS learning_insight_events (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            profile_id TEXT,
+            insight_id INTEGER,
+            aussage TEXT DEFAULT '',
+            von TEXT DEFAULT '',
+            nach TEXT NOT NULL,
+            herkunft TEXT DEFAULT '',
+            am TEXT NOT NULL
+        )
+    """)
+
+
+def _jetzt() -> str:
+    return datetime.now().isoformat(timespec="seconds")
+
+
+def _zeile(db, insight_id):
+    try:
+        iid = int(str(insight_id).strip())
+    except (TypeError, ValueError):
+        return None
+    return db.connect().execute(
+        "SELECT id, title, COALESCE(bestaetigt_vom_user, 0) AS bvu, is_active "
+        "FROM learning_insights WHERE id=? "
+        "AND (profile_id=? OR profile_id='' OR profile_id IS NULL)",
+        (iid, db.get_active_profile_id() or "")).fetchone()
+
+
+def _protokoll(conn, pid, row, nach: str, herkunft: str) -> None:
+    tabelle_anlegen(conn)
+    conn.execute(
+        "INSERT INTO learning_insight_events (profile_id, insight_id, aussage, "
+        "von, nach, herkunft, am) VALUES (?,?,?,?,?,?,?)",
+        (pid, row["id"], row["title"], status_name(row["bvu"]) if row["is_active"]
+         or row["bvu"] else "stumm", nach, herkunft, _jetzt()))
+
+
+_NICHT_GEFUNDEN = {"fehler": "Erkenntnis nicht gefunden. IDs liefert erkenntnisse_anzeigen()."}
+
+
+def setzen(db: Any, insight_id, status: str, herkunft: str = "ich") -> dict:
+    """Setzt einen der vier Zustaende oder loescht (`status='loeschen'`)."""
+    if status == "loeschen":
+        return loeschen(db, insight_id, herkunft=herkunft)
+    if status not in STATUS or status == "offen":
+        return {"fehler": "status muss bestaetigt, widersprochen, vergessen oder loeschen sein."}
+    row = _zeile(db, insight_id)
+    if not row:
+        return dict(_NICHT_GEFUNDEN)
+    conn = db.connect()
+    pid = db.get_active_profile_id() or ""
+    aktiv = 0 if status == "vergessen" else 1
+    conn.execute(
+        "UPDATE learning_insights SET bestaetigt_vom_user=?, is_active=?, "
+        "dismissed_at=CASE WHEN ?=0 THEN ? ELSE dismissed_at END WHERE id=?",
+        (STATUS[status], aktiv, aktiv, _jetzt(), row["id"]))
+    _protokoll(conn, pid, row, status, herkunft)
+    conn.commit()
+    return {"status": status, "id": row["id"], "aussage": row["title"],
+            "bedeutung": ERKLAERUNG[status]}
+
+
+def loeschen(db: Any, insight_id, herkunft: str = "ich") -> dict:
+    row = _zeile(db, insight_id)
+    if not row:
+        return dict(_NICHT_GEFUNDEN)
+    conn = db.connect()
+    _protokoll(conn, db.get_active_profile_id() or "", row, "geloescht", herkunft)
+    conn.execute("DELETE FROM learning_insights WHERE id=?", (row["id"],))
+    conn.commit()
+    return {"status": "geloescht", "id": row["id"], "aussage": row["title"],
+            "bedeutung": ERKLAERUNG["geloescht"]}
+
+
+def zuruecksetzen(db: Any, kategorie: str = "", stichtag: str = "",
+                  dry_run: bool = True) -> dict:
+    """Setzt Erkenntnisse auf `vergessen` — alle, eine Art oder alle, die
+    VOR einem Stichtag zuerst abgeleitet wurden.
+
+    Widersprochene bleiben widersprochen: ein Zuruecksetzen soll alte
+    Muster neu pruefen lassen, nicht Fehlableitungen wiederbeleben."""
+    tag = ""
+    if stichtag:
+        try:
+            tag = date.fromisoformat(str(stichtag).strip()[:10]).isoformat()
+        except ValueError:
+            return {"fehler": "stichtag ist ein Datum im Format JJJJ-MM-TT, z. B. 2026-07-24."}
+    conn = db.connect()
+    pid = db.get_active_profile_id() or ""
+    sql = ("SELECT id, kind, title, first_seen_at, COALESCE(bestaetigt_vom_user, 0) AS bvu, "
+           "is_active FROM learning_insights "
+           "WHERE (profile_id=? OR profile_id='' OR profile_id IS NULL) AND is_active=1 "
+           "AND COALESCE(bestaetigt_vom_user, 0) IN (0, 1)")
+    args: list = [pid]
+    if kategorie:
+        sql += " AND kind=?"
+        args.append(kategorie)
+    if tag:
+        sql += " AND substr(first_seen_at, 1, 10) < ?"
+        args.append(tag)
+    rows = conn.execute(sql + " ORDER BY first_seen_at", args).fetchall()
+    betroffen = [{"id": r["id"], "art": r["kind"], "aussage": r["title"],
+                  "abgeleitet_am": (r["first_seen_at"] or "")[:10],
+                  "status": status_name(r["bvu"])} for r in rows]
+    antwort = {"betroffen": betroffen, "anzahl": len(betroffen),
+               "hinweis": ("Betroffen sind nur Erkenntnisse — Bewerbungen, Stellen "
+                           "und Aussortier-Gründe bleiben unverändert.")}
+    if dry_run:
+        antwort["status"] = "vorschau"
+        antwort["naechster_schritt"] = ("Mit dry_run=False ausführen, danach "
+                                        "erkenntnisse_ableiten(dry_run=True) für eine "
+                                        "Vorschau der neuen Ableitung.")
+        return antwort
+    for r in rows:
+        conn.execute(
+            "UPDATE learning_insights SET bestaetigt_vom_user=?, is_active=0, "
+            "dismissed_at=? WHERE id=?", (STATUS["vergessen"], _jetzt(), r["id"]))
+        _protokoll(conn, pid, r, "vergessen", "zuruecksetzen")
+    conn.commit()
+    antwort["status"] = "vergessen"
+    antwort["naechster_schritt"] = ("Jetzt neu ableiten: erkenntnisse_ableiten("
+                                    "dry_run=True) zeigt, was aus den heutigen Daten "
+                                    "entstuende.")
+    return antwort
+
+
+def verlauf(db: Any, limit: int = 50) -> list[dict]:
+    conn = db.connect()
+    tabelle_anlegen(conn)
+    return [dict(r) for r in conn.execute(
+        "SELECT insight_id, aussage, von, nach, herkunft, am FROM learning_insight_events "
+        "WHERE profile_id=? ORDER BY id DESC LIMIT ?",
+        (db.get_active_profile_id() or "", max(1, min(int(limit or 50), 500))))]
